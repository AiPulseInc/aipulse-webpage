# Ai Pulse — env vars template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase (client-side, used in samoocena + contact form)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Fallback name used in newer Supabase JS (optional)
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google Analytics 4 (Consent Mode v2)
# Measurement ID is public — OK to embed in bundle.
# Empty value disables GA entirely (see src/ga.js guard).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-side (scripts, never VITE_ prefix)
# GEMINI_API_KEY=...            # for scripts/generate-images.mjs (Nano Banana 2)
# RESEND_API_KEY=...             # for supabase edge fn contact
