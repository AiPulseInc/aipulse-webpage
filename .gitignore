# Media files (design artifacts, not web assets)
*.mov
*.mp4
assets/animations/
assets/duplicated frames/

# Design reference screenshots (not site assets)
image.png
image copy*.png

# Temp bin (pre-delete staging)
_bin/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
